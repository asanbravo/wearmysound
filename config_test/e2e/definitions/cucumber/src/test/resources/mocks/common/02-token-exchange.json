{
  "request": {
    "method": "POST",
    "url": "/api/token"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "mock-access-token",
      "token_type": "Bearer",
      "expires_in": 3600,
      "refresh_token": "mock-refresh-token",
      "scope": "user-read-email user-read-private"
    }
  }
}
