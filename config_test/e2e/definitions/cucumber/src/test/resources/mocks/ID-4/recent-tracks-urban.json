{
  "request": {
    "method": "GET",
    "urlPath": "/v1/me/player/recently-played",
    "queryParameters": {
      "limit": { "equalTo": "20" }
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "items": [
        { "track": { "id": "track1", "name": "Song A", "artists":[{ "name":"Artist A"}] } },
        { "track": { "id": "track2", "name": "Song B", "artists":[{ "name":"Artist B"}] } }
      ]
    }
  }
}